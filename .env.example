HOST=127.0.0.1
API_PORT=4175
WEB_PORT=4174
DATA_DIR=runtime
# PYTHON=python
# Hours a source is kept after import, and an export after it is saved. The
# deadline is fixed at that moment: opening a project never extends it.
SOURCE_RETENTION_HOURS=36
# How many media jobs (download, normalize, isolate, accept an export) run at
# once; everything past that waits in line and is told its position.
MEDIA_JOB_CONCURRENCY=2
# Storage safeguards. New imports are refused while free disk is at or below
# the reserve, or the workspace is within 5% of its own allowance, and are
# accepted again as soon as the retention sweep frees space.
# STORAGE_LIMIT_GB=0
STORAGE_RESERVE_GB=2
# Sign-in is per account, created with `pnpm user add <username>`. At least one
# account must exist before the server will listen on a non-loopback address.
# Exact public URL required for remote access; configure TLS at your reverse proxy.
PUBLIC_ORIGIN=http://localhost:4174
